# 可选：百炼 Key；未配置时本地地图、任务计划和离线能力仍可启动
DASHSCOPE_API_KEY=

# 可选：Tavily 联网搜索 Key；未配置时联网检索会返回未启用提示
TAVILY_API_KEY=

# 模型
QWEN_CHAT_MODEL=qwen-vl-plus
QWEN_OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 可选：切换到本地 OpenAI-compatible 纯文本后端（不声明 tools 时不会执行系统命令）
# CSTF_LLM_BACKEND=local
# CSTF_LLM_BASE_URL=http://127.0.0.1:8000/v1
# CSTF_LLM_API_KEY=local
# CSTF_LOCAL_SUPPORTS_TOOLS=0
# CSTF_LOCAL_SUPPORTS_VISION=0

# GEE（实际下载/受控验收需要；不要填写未经授权的项目）
# EE_PROJECT=

# 远程 Gateway（公开/非 loopback 绑定时必须设置；不要提交真实值）
CSTF_GATEWAY_HOST=127.0.0.1
CSTF_GATEWAY_PORT=9080
CSTF_GATEWAY_ACCESS_TOKEN=
CSTF_PUBLIC_URL=

# 本地 OpenAI-compatible API（Bearer token 必填）
CSTF_LOCAL_API_HOST=127.0.0.1
CSTF_LOCAL_API_PORT=8000
CSTF_LOCAL_API_TOKEN=
CSTF_LOCAL_MODEL_PATH=./Qwen_Agent_Merged

# TIFF 对话输入策略
YYNET_TIFF_MODE=auto
YYNET_ATTACH_GEO_META=0
YYNET_TIFF_AUTO_PNG_MB=12
YYNET_VLM_MAX_SIDE=2048

# 聊天框原始 SYSTEM_COMMAND_JSON 仅本地验收使用；默认关闭，开启后仍需会话内勾选授权
CSTF_ALLOW_RAW_SYSTEM_COMMAND=0

# 本地知识库（可选；维护 CLI 与 Agent 查询共用）
CHROMA_RS_DB_PATH=./rs_knowledge_db
CSTF_KB_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# 后台任务账本（SQLite；进程重启会将未完成任务标记为 INTERRUPTED）
CSTF_JOB_DB_PATH=./data/jobs.sqlite3
# 任务时间线账本（JSON；可为每个实例/验收运行隔离）
CSTF_TIMELINE_LEDGER_PATH=./data/timeline_ledger.json

# 代理（建议清空，避免 Connection error）
HTTP_PROXY=
HTTPS_PROXY=
ALL_PROXY=
NO_PROXY=localhost,127.0.0.1,::1,dashscope.aliyuncs.com

# Windows OpenMP 兼容
KMP_DUPLICATE_LIB_OK=TRUE

# E1 多源数据集根目录（按需修改）
# E1_DATA_ROOT=E:\潮滩数据集
